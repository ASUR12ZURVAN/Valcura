# Django Settings
SECRET_KEY=your_django_secret_key_here_change_this_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=valcura_production
DB_USER=valcura_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=5432

# Alternative: Use DATABASE_URL for Render/Heroku
# DATABASE_URL=postgresql://valcura_user:password@localhost:5432/valcura_production

# Cache Configuration (Redis)
REDIS_URL=redis://localhost:6379/1
# Alternative: Individual Redis settings
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=1

# Google Sheets API Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=1PLPAP2W6iZHqo47KG60sqNmv1EHwE4PG4Eh1wUYyPdY
GOOGLE_SHEETS_PATIENT_SHEET=Patient Status

# Option 1: Service Account File Path
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service-account.json

# Option 2: Service Account JSON as Environment Variable (Recommended for Render)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "your-project-id", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "...", "token_uri": "...", "auth_provider_x509_cert_url": "...", "client_x509_cert_url": "..."}'

# Optional: Google Sheets Webhook (alternative to service account)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_from_meta_business_suite
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhooks/whatsapp/

# Excel File Configuration (for database import)
EXCEL_FILE_PATH=Valcura - Master Revenue Intelligence Database.xlsx

# Automation Configuration
AUTOMATION_DATA_SOURCE=database
AUTOMATION_CHECK_INTERVAL_MINUTES=30

# Celery Configuration (Optional - for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@valcura.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/valcura/app.log

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Application Settings
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# Clinic Configuration (Default values)
DEFAULT_CLINIC_ID=CLINIC001
DEFAULT_CLINIC_NAME=Valcura Clinic
DEFAULT_CLINIC_CITY=Mumbai
DEFAULT_CLINIC_LOCALITY=Andheri West

# WhatsApp Template Configuration
WHATSAPP_TEMPLATE_NAMESPACE=your_template_namespace
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# API Rate Limiting
WHATSAPP_RATE_LIMIT=1000
GOOGLE_SHEETS_RATE_LIMIT=100

# Monitoring and Analytics (Optional)
SENTRY_DSN=your_sentry_dsn_for_error_tracking
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# Feature Flags
ENABLE_WHATSAPP_AUTOMATION=True
ENABLE_GOOGLE_SHEETS_SYNC=True
ENABLE_DATABASE_AUTOMATION=True
ENABLE_APPOINTMENT_REMINDERS=True
ENABLE_FOLLOWUP_AUTOMATION=True

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# Development/Testing
TEST_MODE=False
MOCK_WHATSAPP_SENDING=False
MOCK_GOOGLE_SHEETS=False
